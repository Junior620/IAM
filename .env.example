# Public site
NEXT_PUBLIC_SITE_URL=https://iam-afrique.org
# Set to false on any production-like environment that must remain private.
SEO_ALLOW_INDEXING=true
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-09
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Sanity preview and revalidation
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Email and routing
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
IAM_CONTACT_EMAIL=
IAM_PARTNERSHIPS_EMAIL=
IAM_SCIENCE_EMAIL=
IAM_MEDIA_EMAIL=
IAM_PHARMACEUTICAL_ALERTS_EMAIL=
IAM_PHILANTHROPY_EMAIL=

# Newsletter topics configured in Resend
RESEND_TOPIC_ALERTS=
RESEND_TOPIC_RESEARCH=
RESEND_TOPIC_INDUSTRY=
RESEND_TOPIC_TRAINING=
RESEND_TOPIC_PHILANTHROPY=
RESEND_TOPIC_INSTITUTIONAL=

# Temporary subscription tokens and rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional IAM documentary assistant
# Both values are required to enable generated answers. Without them, local answers remain active.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=

# Set to true to publish the main institutional page
INSTITUTE_PAGE_ENABLED=false

# Set to true to publish the participation page
PARTICIPATE_PAGE_ENABLED=false

# Set to true to publish the main news and media page
NEWS_MEDIA_PAGE_ENABLED=false

# Set to true to publish the newsletter subscription page
NEWSLETTER_PAGE_ENABLED=false

# Payment adapters stay disabled until legal approval
DONATIONS_ENABLED=false
DONATION_PROVIDER=
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
